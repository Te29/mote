# =============================================================================
# MOTE CONFIGURATION
# =============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env
# 
# The Flow:
# .env file
#     ↓
# dotenv.config() loads into process.env
#     ↓
# loadBrowserConfig() reads process.env, returns typed object
#     ↓
# Pass config object to launchBrowser(), navigateTo(), etc.

# -----------------------------------------------------------------------------
# LLM (Language Model) Settings
# -----------------------------------------------------------------------------

# Provider: "ollama" for local, "openai" for cloud
LLM_PROVIDER=ollama

# API Base URL
# - Ollama: http://localhost:11434/v1
# - OpenAI: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1

# API Key
# - Ollama: use "ollama" (it doesn't need a real key)
# - OpenAI: your actual API key (sk-...)
LLM_API_KEY=ollama

# Model name
# - Ollama: llama3.2, mistral, codellama, etc.
# - OpenAI: gpt-4o-mini, gpt-4o, etc.
LLM_MODEL=llama3.2

# Prompt token limits
# Tune these based on your model's context window size
# Smaller models (8K context): consider halving these values
# Larger models (128K context): can increase for richer context
LLM_PROMPT_MARKDOWN_TOKENS=1500    # Max tokens for page markdown content
LLM_PROMPT_ELEMENTS_TOKENS=2000    # Max tokens for interactive elements
LLM_PROMPT_MAX_ELEMENTS=50         # Max number of elements to include
LLM_PROMPT_HISTORY_TOKENS=200      # Max tokens for action history

# -----------------------------------------------------------------------------
# Browser Settings
# -----------------------------------------------------------------------------

# Run without visible window? (true/false)
HEADLESS=false

# Anti-bot stealth mode (true/false)
# Default is true. Set to false to identify as an automation bot.
STEALTH=true

# Browser profile path (persists cookies, logins, history)
# Default: ./mote-profile (persistent)
# Set to 'none' for ephemeral (fresh browser each time)
PROFILE_PATH=./mote-profile

# Tip: Use Win+Left or Win+Right to snap browser to half-screen

# Slow down actions by this many milliseconds
# 0 = full speed, 50-100 = watchable, 500+ = slow motion
SLOW_MO=100

# Timeout settings (milliseconds)
TIMEOUT_DEFAULT=30000       # Playwright's default for unspecified ops
TIMEOUT_NAVIGATION=30000    # page.goto()
TIMEOUT_ELEMENT=5000        # click(), type(), waitForSelector()
TIMEOUT_POST_NAV_DELAY=500  # Pause after navigation for JS to render
```

# -----------------------------------------------------------------------------
# Agent Settings
# -----------------------------------------------------------------------------

# Maximum steps before giving up
MAX_STEPS=20

# Human confirmation mode:
# - "all": Confirm every action
# - "destructive": Confirm clicks and form submissions only
# - "none": Fully autonomous
CONFIRM_MODE=destructive

# Pause between steps (milliseconds)
STEP_PAUSE=500

# Show detailed logs? (true/false)
VERBOSE=true