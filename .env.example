# =============================================================================
# MOTE CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. Copy this file to .env: "cp .env.example .env"
# 2. Customize the settings below for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# ESSENTIAL SETTINGS (You likely want to change these)
# -----------------------------------------------------------------------------

# LLM Provider: "ollama" (local) or "openai" (cloud)
LLM_PROVIDER=ollama

# LLM Model Name
# - Ollama: llama3.2, qwen2.5, mistral, etc.
# - OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL=llama3.2

# LLM Base URL
# - Ollama Default: http://localhost:11434/v1
# - OpenAI Default: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1

# LLM API Key
# - Ollama: "ollama" (no key needed)
# - OpenAI: "sk-..." (your actual key)
LLM_API_KEY=ollama

# Browser Visibility
# - false: Open a visible browser window (Recommended for debugging/watching)
# - true: Run in background (Faster, good for production/servers)
# HEADLESS=false

# -----------------------------------------------------------------------------
# ADVANCED TUNING (Uncomment config below to override defaults)
# -----------------------------------------------------------------------------

# --- Browser Behavior ---
# STEALTH=true                 # Anti-bot detection (Default: true)
# PROFILE_PATH=./mote-profile  # 'none' for ephemeral, path for persistent
# SLOW_MO=100                  # Delay in ms between actions (0=fast, 100=watchable)

# --- Agent Control ---
# MAX_STEPS=50                 # Fail after this many steps (-1 = unlimited)
# ENGAGEMENT_MODE=standard     # modes: autonomous, minimal, standard, supervised, full
# VERBOSE=true                 # detailed logging

# --- Timeouts (milliseconds) ---
# TIMEOUT_DEFAULT=30000        # 30s global timeout
# TIMEOUT_NAVIGATION=30000     # 30s page load timeout
# TIMEOUT_ELEMENT=5000         # 5s wait for element to appear
# POST_NAV_DELAY=500           # 0.5s pause after navigation

# --- LLM Context Limits (Token counts) ---
# LLM_PROMPT_MARKDOWN_TOKENS=4000    # Page content size
# LLM_PROMPT_ELEMENTS_TOKENS=3000    # Interactive elements size
# LLM_PROMPT_MAX_ELEMENTS=100        # Max clickable items to show
# LLM_PROMPT_HISTORY_TOKENS=1000     # Action history size