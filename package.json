{
  "name": "mote",
  "version": "0.1.0",
  "description": "A beginner-friendly browser automation framework powered by AI.",
  "type": "module",
  "main": "src/mote.ts",
  "scripts": {
    "start": "tsx src/mote.ts",
    "record": "tsx src/mote.ts --record",
    "dev": "tsx watch src/mote.ts",
    "test": "vitest --exclude **/live.test.ts",
    "test:live": "vitest run --exclude **/mock.test.ts",
    "test:browser": "vitest run tests/browser/mock.test.ts",
    "test:browser:live": "vitest run tests/browser/live.test.ts",
    "test:observe": "vitest run tests/observe/mock.test.ts",
    "test:observe:live": "vitest run tests/observe/live.test.ts",
    "test:reason": "vitest run tests/reason/mock.test.ts",
    "test:reason:live": "vitest run tests/reason/live.test.ts",
    "test:act": "vitest run tests/act/mock.test.ts",
    "test:act:live": "vitest run tests/act/live.test.ts",
    "test:mote": "vitest run tests/mote/mock.test.ts",
    "test:mote:live": "vitest run tests/mote/live.test.ts",
    "test:integration": "vitest run tests/integration/",
    "demo": "tsx demos/quiz.ts",
    "demo:quiz": "tsx demos/quiz.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^16.4.5",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^24.1.0",
    "openai": "^4.52.0",
    "playwright": "^1.45.0",
    "turndown": "^7.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.9",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.4"
  }
}
